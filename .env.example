# Host port mapped to the container's port 8080.
FLAREDNS_PORT=8080

# Keep the default to build locally, or use ghcr.io/mikusaa/flaredns:latest.
FLAREDNS_IMAGE=flaredns:local

# Set this to the exact URL used in the browser. Passkey requires HTTPS except on localhost.
FLAREDNS_PUBLIC_URL=http://localhost:8080

# Leave empty to derive it from FLAREDNS_PUBLIC_URL. Changing it invalidates existing Passkeys.
FLAREDNS_RP_ID=

FLAREDNS_SESSION_TTL=12h
FLAREDNS_TRUSTED_PROXIES=
FLAREDNS_LOG_LEVEL=info
FLAREDNS_COOKIE_SECURE=
TZ=Asia/Shanghai
